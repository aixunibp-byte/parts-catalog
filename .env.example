# Скопируйте в .env и заполните реальными значениями: cp .env.example .env
# Затем: chmod 600 .env

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=parts_catalog
DB_USER=parts_app
DB_PASSWORD=

# --- Ozon Seller API (read-only ключ) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- FastAPI ---
APP_ENV=production
APP_SECRET_KEY=

# --- Админ-панель ---
ADMIN_TOKEN=

# --- Планировщик синхронизации (минуты) ---
SYNC_INTERVAL_MINUTES=60

# --- Загрузка файлов ---
UPLOAD_DIR=/app/uploads
